{
  "name": "phd-roadmap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir .roadmap-ssr",
    "prerender": "node scripts/prerender.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check:links": "node scripts/check-links.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:server && npm run prerender && npm run verify:dist",
    "preview": "vite preview",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
